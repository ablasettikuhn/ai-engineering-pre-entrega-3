# Copia este archivo como .env y completa tus claves (el .env NO se sube a GitHub)

# --- Claves ---
# Obligatoria: Gemini se usa para los embeddings y como LLM principal (plan gratuito)
GOOGLE_API_KEY=tu_clave_de_gemini
# Opcional: si la defines, Claude queda como fallback (o como principal, ver PROVEEDOR_PRINCIPAL)
ANTHROPIC_API_KEY=

# --- LLM ---
PROVEEDOR_PRINCIPAL=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_MODEL=claude-haiku-5-5
MAX_TOKENS=1024
MAX_INTENTOS=3

# --- Embeddings (si los cambias, ejecuta: python ingesta.py --forzar) ---
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=768
EMBEDDINGS_TOKENS_POR_MINUTO=25000

# --- Chunking y recuperación ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
COLLECTION_NAME=papers_ciencias_deporte
